# Visible copy of .env.example for archive tools that omit dot-prefixed files.
# scripts/setup.sh accepts either name and creates the local .env file.

# Local-only Jupyter URL: http://127.0.0.1:JUPYTER_PORT/lab
JUPYTER_PORT=8888

# scripts/setup.sh replaces this with a random 48-character token.
JUPYTER_TOKEN=replace-with-at-least-24-random-characters

# scripts/setup.sh fills these from `id -u` and `id -g` before the image build.
HOST_UID=1000
HOST_GID=1000

# Dell workstation defaults: reserve the 8 CPU cores, leave ~16 GB RAM to Ubuntu,
# and expose the single NVIDIA RTX A3000 as GPU 0.
CPU_LIMIT=8
MEMORY_LIMIT=112g
SHM_SIZE=16gb
GPU_DEVICE_ID=0

# Thread counts used by OpenMP, OpenBLAS, MKL, NumExpr, Polars, Arrow, and R.
CPU_THREADS=8

# Rebuild with a newer compatible Bioconductor release only after testing.
BIOC_VERSION=RELEASE_3_23

# Python-to-R bridge, compiled against the R installation in the image.
RPY2_VERSION=3.6.6
